#Область ВспомогательныеМетоды

Процедура ОтправитьДанныеДокументаНаДругойБазу(ДокументОбъект)
	
	СтрокаПодключения = "http://192.168.0.8/hs/vacations_api/update_doc";
	ТаймаутСоединения = 60;
	ДанныеДляОтправки = ПолучитьДанныеДокументаДляОтправки(ДокументОбъект);
	
	Попытка
		АдресСервера = ПолучитьАдресСервераИзURL(СтрокаПодключения);
		ПутьРесурса = ПолучитьПутьРесурсаИзURL(СтрокаПодключения);
		
		HTTPСоединение = Новый HTTPСоединение(АдресСервера, , , , , ТаймаутСоединения);
		HTTPЗапрос = Новый HTTPЗапрос(ПутьРесурса);
		HTTPЗапрос.УстановитьТелоИзСтроки(ЗаписатьЗначениеJSON(ДанныеДляОтправки));
		HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json");
		
		Результат = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
		
		КодУспешногоОтвета = 299;
		Если Результат.КодСостояния > КодУспешногоОтвета Тогда
			ЗаписьЖурналаРегистрации("HTTP-сервис", УровеньЖурналаРегистрации.Ошибка, , , 
				"Ошибка при отправке данных на другую базу. Код ответа: " + Результат.КодСостояния);
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("HTTP-сервис", УровеньЖурналаРегистрации.Ошибка, , , 
			"Ошибка при отправке данных на другую базу: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

Функция ПолучитьДанныеДокументаДляОтправки(ДокументОбъект)

	Результат = Новый Структура;
	Результат.Вставить("GUID", Строка(ДокументОбъект.УникальныйИдентификатор()));
	
	Результат.Вставить("ПометкаУдаления", ДокументОбъект.ПометкаУдаления);
	Результат.Вставить("Проведен", ДокументОбъект.Проведен);

	Результат.Вставить("Вид", ДокументОбъект.Вид.Имя);
	Результат.Вставить("Статус", ДокументОбъект.Статус.Имя);
	Результат.Вставить("СотрудникGUID", Строка(ДокументОбъект.Сотрудник.УникальныйИдентификатор()));

	Результат.Вставить("ДатаНачала", ДокументОбъект.ДатаНачала);
	Результат.Вставить("ДатаОкончания", ДокументОбъект.ДатаОкончания);
	Результат.Вставить("Длительность", ДокументОбъект.Длительность);
	Результат.Вставить("ОтветственныйGUID", Строка(ДокументОбъект.Ответственный.УникальныйИдентификатор()));
	Результат.Вставить("Комментарий", ДокументОбъект.Комментарий);

	Возврат Результат;

КонецФункции

Функция ПолучитьАдресСервераИзURL(URL)
	
	Разделитель = "://";
	ЧастиURL = СтрРазделить(URL, Разделитель, Ложь);
	ЧастьПослеПротокола = ЧастиURL[1];
	ПутьИРесурс = СтрРазделить(ЧастьПослеПротокола, "/", Ложь);
	
	Возврат ПутьИРесурс[0];
	
КонецФункции

Функция ПолучитьПутьРесурсаИзURL(URL)
	
	Разделитель = "://";
	ЧастиURL = СтрРазделить(URL, Разделитель, Ложь);
	ЧастьПослеПротокола = ЧастиURL[1];
	ПутьИРесурс = СтрРазделить(ЧастьПослеПротокола, "/", Ложь);
	
	РесурсНаСервере = "/" + СтрСоединить(ПутьИРесурс.Скопировать(1, ПутьИРесурс.Количество() - 1), "/");
	
	Возврат РесурсНаСервере;
	
КонецФункции

