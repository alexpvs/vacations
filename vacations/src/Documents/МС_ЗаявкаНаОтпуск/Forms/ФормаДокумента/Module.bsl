#Область ПроцедурыОбщегоНазначения 

&НаКлиенте
Процедура РассчитатьДлительность()
	
	Если НЕ ЗначениеЗаполнено(Объект.ДатаНачала)
		ИЛИ НЕ ЗначениеЗаполнено(Объект.ДатаОкончания) Тогда
		
		Объект.Длительность = 0;
		Возврат;
	КонецЕсли;

	чСекунд = (КонецДня(Объект.ДатаОкончания) - НачалоДня(Объект.ДатаНачала)) + 1;
	Объект.Длительность = чСекунд / (24*60*60);
	
	Рез = ПолучитьИнформативныеОстатки();
	ЗаполнитьИнформативныеОстатки(Рез);

КонецПроцедуры // РассчитатьДлительность()

&НаСервере
Процедура ЗаполнитьИнформативныеОстатки(Структ)

	ОстатокНаНачалоПериода 	= Структ.ОстатокНаНачалоПериода;
	ОстатокНаКонецПериода 	= Структ.ОстатокНаКонецПериода;

КонецПроцедуры // ЗаполнитьИнформативныеОстатки()

&НаСервере
Процедура ЗаполнитьСписокДоступныхСтатусов()
	
	Если Пользователи.РолиДоступны("РасширенныйДоступКЗаявкамНаОтпуск")
		ИЛИ Пользователи.ЭтоПолноправныйПользователь() Тогда
		
		СписокДоступныхСтатусов.Очистить();
		СписокДоступныхСтатусов.Добавить(Перечисления.МС_СтатусыЗаявкиНаОтпуск.Заявка);
		СписокДоступныхСтатусов.Добавить(Перечисления.МС_СтатусыЗаявкиНаОтпуск.Согласована);
		СписокДоступныхСтатусов.Добавить(Перечисления.МС_СтатусыЗаявкиНаОтпуск.Утверждена);
		СписокДоступныхСтатусов.Добавить(Перечисления.МС_СтатусыЗаявкиНаОтпуск.Выполнена);
		СписокДоступныхСтатусов.Добавить(Перечисления.МС_СтатусыЗаявкиНаОтпуск.Отменена);
		
		Возврат;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РС.Пользователь КАК Пользователь,
	|	РС.ИмеетПравоНаСогласование КАК ИмеетПравоНаСогласование,
	|	РС.ИмеетПравоНаУтверждение КАК ИмеетПравоНаУтверждение,
	|	РС.ИмеетПравоНаОтмену КАК ИмеетПравоНаОтмену,
	|	РС.ИмеетПравоНаВыполнение КАК ИмеетПравоНаВыполнение
	|ИЗ
	|	РегистрСведений.МС_УровеньДоступаКЗаявкамНаОтпуск КАК РС
	|ГДЕ
	|	РС.Пользователь = &Пользователь";
	
	Запрос.УстановитьПараметр("Пользователь", Пользователи.ТекущийПользователь());
	
	СписокДоступныхСтатусов.Очистить();
	СписокДоступныхСтатусов.Добавить(Перечисления.МС_СтатусыЗаявкиНаОтпуск.Заявка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если Выборка.ИмеетПравоНаСогласование Тогда
			СписокДоступныхСтатусов.Добавить(Перечисления.МС_СтатусыЗаявкиНаОтпуск.Согласована);
		КонецЕсли;
		Если Выборка.ИмеетПравоНаУтверждение Тогда
			СписокДоступныхСтатусов.Добавить(Перечисления.МС_СтатусыЗаявкиНаОтпуск.Утверждена);
		КонецЕсли;
		Если Выборка.ИмеетПравоНаВыполнение Тогда
			СписокДоступныхСтатусов.Добавить(Перечисления.МС_СтатусыЗаявкиНаОтпуск.Выполнена);
		КонецЕсли;
		Если Выборка.ИмеетПравоНаОтмену Тогда
			СписокДоступныхСтатусов.Добавить(Перечисления.МС_СтатусыЗаявкиНаОтпуск.Отменена);
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры // ЗаполнитьСписокДоступныхСтатусов()

&НаСервере
Функция ПолучитьИнформативныеОстатки()
	
	СтруктураВозврата = Новый Структура("ОстатокНаНачалоПериода,ОстатокНаКонецПериода", 0, 0);
	
	Если Не ЗначениеЗаполнено(Объект.ДатаНачала) Тогда
		Возврат СтруктураВозврата;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РС.Сотрудник КАК Сотрудник,
	|	РС.КоличествоДней КАК КоличествоДней
	|ПОМЕСТИТЬ ВТ_НаНачалоГода
	|ИЗ
	|	РегистрСведений.МС_ОстаткиОтпусков.СрезПоследних(&НачГода, Сотрудник = &Сотрудник) КАК РС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.Сотрудник КАК Сотрудник,
	|	СУММА(Т.КолвоДней) КАК КолвоДней
	|ПОМЕСТИТЬ ВТ_Потрачено
	|ИЗ
	|	(ВЫБРАТЬ
	|		МС_ГрафикОтпусковСрезПоследних.Сотрудник КАК Сотрудник,
	|		МС_ГрафикОтпусковСрезПоследних.ДеньПериода КАК ДеньПериода,
	|		1 КАК КолвоДней
	|	ИЗ
	|		РегистрСведений.МС_ГрафикОтпусков.СрезПоследних(, Сотрудник = &Сотрудник) КАК МС_ГрафикОтпусковСрезПоследних
	|	ГДЕ
	|		НЕ МС_ГрафикОтпусковСрезПоследних.Статус = &СтатусОтменено
	|		И МС_ГрафикОтпусковСрезПоследних.ДеньПериода МЕЖДУ &НачГода И &ДатаДок) КАК Т
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.Сотрудник
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т1.Сотрудник КАК Сотрудник,
	|	СУММА(Т1.НачОст) КАК НачОст,
	|	СУММА(Т1.Потрачено) КАК Потрачено
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВТ_НаНачалоГода.Сотрудник КАК Сотрудник,
	|		ВТ_НаНачалоГода.КоличествоДней КАК НачОст,
	|		0 КАК Потрачено
	|	ИЗ
	|		ВТ_НаНачалоГода КАК ВТ_НаНачалоГода
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ВТ_Потрачено.Сотрудник,
	|		0,
	|		ВТ_Потрачено.КолвоДней
	|	ИЗ
	|		ВТ_Потрачено КАК ВТ_Потрачено) КАК Т1
	|
	|СГРУППИРОВАТЬ ПО
	|	Т1.Сотрудник";
	
	Запрос.УстановитьПараметр("НачГода", 		КонецДня(НачалоГода(Объект.ДатаНачала)));
	Запрос.УстановитьПараметр("Сотрудник", 		Объект.Сотрудник);
	Запрос.УстановитьПараметр("СтатусОтменено", Перечисления.МС_СтатусыЗаявкиНаОтпуск.Отменена);
	Запрос.УстановитьПараметр("ДатаДок", 		КонецДня(НачалоДня(Объект.ДатаНачала)-100));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СтруктураВозврата.ОстатокНаНачалоПериода = Выборка.НачОст - Выборка.Потрачено + ПоложенноеКолвоДнейОтпуска(Объект.ДатаНачала);
	КонецЕсли;
	
	СтруктураВозврата.Вставить("ОстатокНаКонецПериода", СтруктураВозврата.ОстатокНаНачалоПериода - ЧислоДней(Объект.ДатаНачала, Объект.ДатаОкончания));
	
	Возврат СтруктураВозврата;

КонецФункции // ПолучитьИнформативныеОстатки()

&НаСервереБезКонтекста
Функция ПоложенноеКолвоДнейОтпуска(ДатаНачалаОтпуска)
	
	ДнейОтпускаВМесяц = 2.33;
	Мес = Месяц(ДатаНачалаОтпуска) - 1;
	Колво = ДнейОтпускаВМесяц * Мес;
	
	ЧислоДней = День(ДатаНачалаОтпуска);
	Если ЧислоДней > 1 Тогда
		КонДень = День(КонецМесяца(ДатаНачалаОтпуска));
		Колво = Колво + Окр(ДнейОтпускаВМесяц * ЧислоДней / КонДень, 2);
	КонецЕсли;
	
	Возврат Колво;

КонецФункции // ПоложенноеКолвоДнейОтпуска()

&НаСервереБезКонтекста
Функция ЧислоДней(НачДата, КонДата)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Т.НачДата КАК НачДата,
	|	Т.КонДата КАК КонДата,
	|	РАЗНОСТЬДАТ(Т.НачДата, Т.КонДата, ДЕНЬ) КАК КолвоДней
	|ИЗ
	|	(ВЫБРАТЬ
	|		&НачДата КАК НачДата,
	|		&КонДата КАК КонДата) КАК Т";
	
	Запрос.УстановитьПараметр("НачДата", НачДата);
	Запрос.УстановитьПараметр("КонДата", КонДата);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Рез = 0;
	Если Выборка.Следующий() Тогда
		Рез = Выборка.КолвоДней+1;
	КонецЕсли;
	
	Возврат Рез;

КонецФункции // ЧислоДней()

