			<value>true</value>
		</right>
	</object>
	<restrictionTemplate>
		<name>ТолькоПоСотруднику</name>
		<condition>ТекущаяТаблица ИЗ #ТекущаяТаблица КАК ТекущаяТаблица
ГДЕ (Сотрудник В (ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка.ФизическоеЛицо ИЗ Справочник.Пользователи ГДЕ Ссылка = &amp;ТекущийПользователь))</condition>
	</restrictionTemplate>
	<restrictionTemplate>
		<name>ТолькоПоСпискуСотрудников</name>
		<condition>ТекущаяТаблица ИЗ #ТекущаяТаблица КАК ТекущаяТаблица
ГДЕ (
Сотрудник В 
(
//это он сам
ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка.ФизическоеЛицо ИЗ Справочник.Пользователи ГДЕ Ссылка = &amp;ТекущийПользователь

ОБЪЕДИНИТЬ ВСЕ
//это дополнительно из регистра - доступные ему сотрудники для просмотра
ВЫБРАТЬ РС.Сотрудник ИЗ РегистрСведений.МС_НастройкиПросмотраРаботСотрудников КАК РС ГДЕ РС.ПользовательВыполнившийВход = &amp;ТекущийПользователь
)

)</condition>
	</restrictionTemplate>
</Rights>
