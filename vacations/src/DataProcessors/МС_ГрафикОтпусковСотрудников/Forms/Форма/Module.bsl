&НаСервере
Процедура ЗаполнитьСписокВыбораОтделов()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ФЛ.Подразделение КАК Отдел,
	|	ФЛ.Подразделение.Наименование КАК ОтделНаименование
	|ИЗ
	|	Справочник.ФизическиеЛица КАК ФЛ
	|ГДЕ
	|	НЕ ФЛ.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОтделНаименование";
	
	Элементы.ОтборПоПодразделению.СписокВыбора.Очистить();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элементы.ОтборПоПодразделению.СписокВыбора.Добавить(Выборка.Отдел);
	КонецЦикла;
	
КонецПроцедуры // ЗаполнитьСписокВыбораОтделов()

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	//отладка
	Если Пользователи.ЭтоПолноправныйПользователь() Тогда
		Элементы.ОтборПоСотруднику.Видимость = Истина;
	Иначе
		Элементы.ОтборПоСотруднику.Видимость = Ложь;
	КонецЕсли;
	
	ЗаполнитьСписокВыбораОтделов();
	
	флВыводитьЗаявки 		= Истина;
	флВыводитьСогласованные = Истина;
	флВыводитьУтвержденные 	= Истина;
	флВыводитьВыполненные 	= Истина;
	флВыводитьОтмененные 	= Истина;
	
	ПериодОтчета.Вариант = ВариантСтандартногоПериода.ПроизвольныйПериод;
	ПериодОтчета.ДатаНачала = НачалоГода(ТекущаяДатаСеанса());
	ПериодОтчета.ДатаОкончания = КонецГода(ТекущаяДатаСеанса());
	
КонецПроцедуры

