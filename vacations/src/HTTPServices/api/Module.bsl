#Область ОбработчикиСобытий

Функция get_all_docsGET(Запрос)
	
	ЗапросДокументов = Новый Запрос;
	ЗапросДокументов.Текст = 
	"ВЫБРАТЬ
	|	МС_ЗаявкаНаОтпуск.Ссылка КАК Ссылка,
	|	МС_ЗаявкаНаОтпуск.ПометкаУдаления КАК ПометкаУдаления,
	|	МС_ЗаявкаНаОтпуск.Номер КАК Номер,
	|	МС_ЗаявкаНаОтпуск.Дата КАК Дата,
	|	МС_ЗаявкаНаОтпуск.Проведен КАК Проведен,
	|	МС_ЗаявкаНаОтпуск.Вид КАК Вид,
	|	МС_ЗаявкаНаОтпуск.Статус КАК Статус,
	|	МС_ЗаявкаНаОтпуск.Сотрудник КАК Сотрудник,
	|	МС_ЗаявкаНаОтпуск.ДатаНачала КАК ДатаНачала,
	|	МС_ЗаявкаНаОтпуск.ДатаОкончания КАК ДатаОкончания,
	|	МС_ЗаявкаНаОтпуск.Длительность КАК Длительность,
	|	МС_ЗаявкаНаОтпуск.Ответственный КАК Ответственный,
	|	МС_ЗаявкаНаОтпуск.Комментарий КАК Комментарий
	|ИЗ
	|	Документ.МС_ЗаявкаНаОтпуск КАК МС_ЗаявкаНаОтпуск
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата";
	
	Рез = Новый Массив;
	Выборка = ЗапросДокументов.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ОднаСтруктура = Новый Структура;
		ОднаСтруктура.Вставить("Номер", 			Выборка.Номер);
		ОднаСтруктура.Вставить("Дата", 				Выборка.Дата);
		ОднаСтруктура.Вставить("Проведен", 			Выборка.Проведен);
		ОднаСтруктура.Вставить("ПометкаУдаления", 	Выборка.ПометкаУдаления);
		ОднаСтруктура.Вставить("Вид", 				Строка(Выборка.Вид));
		ОднаСтруктура.Вставить("Статус", 			Строка(Выборка.Статус));
		ОднаСтруктура.Вставить("Сотрудник", 		Строка(Выборка.Сотрудник));
		ОднаСтруктура.Вставить("ДатаНачала", 		Выборка.ДатаНачала);
		ОднаСтруктура.Вставить("ДатаОкончания", 	Выборка.ДатаОкончания);
		ОднаСтруктура.Вставить("Длительность", 		Выборка.Длительность);
		ОднаСтруктура.Вставить("Ответственный", 	Строка(Выборка.Ответственный));
		ОднаСтруктура.Вставить("Комментарий", 		Выборка.Комментарий);
		
		Рез.Добавить(ОднаСтруктура);
		
	КонецЦикла;
	
	Ответ = Новый HTTPСервисОтвет(200);
	
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("data", Рез);
	СтруктураОтвета.Вставить("count", Рез.Количество());
	
	ЗапДЖ = Новый ЗаписьJSON;
	ЗапДЖ.УстановитьСтроку();
	ЗаписатьJSON(ЗапДЖ, СтруктураОтвета);
	ТелоВJSON = ЗапДЖ.Закрыть();
	
	Ответ.УстановитьТелоИзСтроки(ТелоВJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;
	
КонецФункции

Функция get_changed_docsGET(Запрос)
	
