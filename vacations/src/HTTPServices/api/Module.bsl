#Область ОбработчикиСобытий

Функция update_docPOST(Запрос)
	
	ДанныеДокумента = ПрочитатьJSONИзЗапроса(Запрос);
	ДокументОбъект = ПолучитьДокументИзДанных(ДанныеДокумента);
	Если ДокументОбъект = Неопределено Тогда
		Возврат Новый HTTPСервисОтвет(404, "Документ не найден");
	КонецЕсли;
	ЗаполнитьРеквизитыДокумента(ДокументОбъект, ДанныеДокумента);
	
	Если ДанныеДокумента.ПометкаУдаления Тогда
		ДокументОбъект.УстановитьПометкуУдаления(Истина);
	Иначе
		ДокументОбъект.УстановитьПометкуУдаления(Ложь);
		Если ДанныеДокумента.Проведен Тогда
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
	КонецЕсли;
	
	КодУспешногоОтвета = 200;
	Ответ = Новый HTTPСервисОтвет(КодУспешногоОтвета);
	СтруктураОтвета = Новый Структура("GUID", Строка(ДокументОбъект.УникальныйИдентификатор()));
	Ответ.УстановитьТелоИзСтроки(ЗаписатьЗначениеJSON(СтруктураОтвета));
	
	Возврат Ответ;
	
КонецФункции

#КонецОбласти

#Область ВспомогательныеМетоды

Функция ПрочитатьJSONИзЗапроса(Запрос)
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку());
	ДанныеДокумента = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();
	
	Возврат ДанныеДокумента;
	
КонецФункции

// Получить документ из данных.
// 
// Параметры:
//  ДанныеДокумента - Произвольный - Данные документа
// 
// Возвращаемое значение:
//  ДокументОбъект.МС_ЗаявкаНаОтпуск, Неопределено - Получить документ из данных
Функция ПолучитьДокументИзДанных(ДанныеДокумента)
	
	ДокументСсылка = Неопределено;
	Если ДанныеДокумента.Свойство("GUID") И ДанныеДокумента.GUID <> Неопределено И ДанныеДокумента.GUID <> "" Тогда
		Попытка
			GUIDДокумента = Новый УникальныйИдентификатор(ДанныеДокумента.GUID);
			ДокументСсылка = Документы.МС_ЗаявкаНаОтпуск.ПолучитьСсылку(GUIDДокумента);
		Исключение
			ЗаписьЖурналаРегистрации("HTTP-сервис", УровеньЖурналаРегистрации.Ошибка, , , 
				"Ошибка при создании GUID документа: " + ОписаниеОшибки());
			Возврат Неопределено;	
		КонецПопытки;
	КонецЕсли;
	
	Если ОбщегоНазначения.СсылкаСуществует(ДокументСсылка) Тогда
		Возврат ДокументСсылка.ПолучитьОбъект();
	Иначе
		Возврат Документы.МС_ЗаявкаНаОтпуск.СоздатьДокумент();
	КонецЕсли;
	
КонецФункции

Процедура ЗаполнитьРеквизитыДокумента(ДокументОбъект, ДанныеДокумента)
	
	ЗаполнитьПеречисление(ДокументОбъект, ДанныеДокумента, "Вид", "МС_ВидыОтпусков");
	ЗаполнитьПеречисление(ДокументОбъект, ДанныеДокумента, "Статус", "МС_СтатусыЗаявкиНаОтпуск");
	ЗаполнитьСправочникПоГуид(ДокументОбъект, ДанныеДокумента, "Сотрудник", "СотрудникGUID", "ФизическиеЛица");
	ЗаполнитьРеквизитПростой(ДокументОбъект, ДанныеДокумента, "ДатаНачала");
	ЗаполнитьРеквизитПростой(ДокументОбъект, ДанныеДокумента, "ДатаОкончания");
	ЗаполнитьРеквизитПростой(ДокументОбъект, ДанныеДокумента, "Длительность");
	ЗаполнитьРеквизитПростой(ДокументОбъект, ДанныеДокумента, "Дата");
	ЗаполнитьРеквизитПростой(ДокументОбъект, ДанныеДокумента, "Номер");
	ЗаполнитьСправочникПоГуид(ДокументОбъект, ДанныеДокумента, "Ответственный", "ОтветственныйGUID", "Пользователи");
	ЗаполнитьРеквизитПростой(ДокументОбъект, ДанныеДокумента, "Комментарий");
	
КонецПроцедуры

Процедура ЗаполнитьПеречисление(ДокументОбъект, ДанныеДокумента, ИмяРеквизита, ИмяПеречисления)
	
	Если ДанныеДокумента.Свойство(ИмяРеквизита) И ДанныеДокумента[ИмяРеквизита] <> Неопределено И ДанныеДокумента[ИмяРеквизита] <> "" Тогда
		Попытка
			МенеджерПеречисления = Перечисления[ИмяПеречисления];
			ДокументОбъект[ИмяРеквизита] = МенеджерПеречисления[ДанныеДокумента[ИмяРеквизита]];
		Исключение
			ЗаписьЖурналаРегистрации("HTTP-сервис", УровеньЖурналаРегистрации.Ошибка, , , 
				"Ошибка при заполнении перечисления " + ИмяРеквизита + ": " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьСправочникПоГуид(ДокументОбъект, ДанныеДокумента, ИмяРеквизита, ИмяПоляГуид, ИмяСправочника)
	
	Если ДанныеДокумента.Свойство(ИмяПоляГуид) И ДанныеДокумента[ИмяПоляГуид] <> Неопределено И ДанныеДокумента[ИмяПоляГуид] <> "" Тогда
		Попытка
			GUIDСправочника = Новый УникальныйИдентификатор(ДанныеДокумента[ИмяПоляГуид]);
			МенеджерСправочника = Справочники[ИмяСправочника];
			ДокументОбъект[ИмяРеквизита] = МенеджерСправочника.ПолучитьСсылку(GUIDСправочника);
		Исключение
			ЗаписьЖурналаРегистрации("HTTP-сервис", УровеньЖурналаРегистрации.Ошибка, , , 
				"Ошибка при заполнении справочника " + ИмяРеквизита + ": " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьРеквизитПростой(ДокументОбъект, ДанныеДокумента, ИмяРеквизита)
	
	Если ДанныеДокумента.Свойство(ИмяРеквизита) И ДанныеДокумента[ИмяРеквизита] <> Неопределено Тогда
		ДокументОбъект[ИмяРеквизита] = ДанныеДокумента[ИмяРеквизита];
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
